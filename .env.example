# Copy to .env.local (and add the same names in Vercel → Settings → Environment Variables).
# Firebase → Project settings → Your apps → Web app → SDK config. These are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
